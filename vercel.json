{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://depthwizard-production-23fa.up.railway.app/api/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://depthwizard-production-23fa.up.railway.app/data/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
